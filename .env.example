# Monada environment — copy to .env, fill in, never commit .env
# Секреты хранить в OS keyring (secret-tool) или здесь только через os.environ[...]

# Proton Bridge (IMAP/SMTP, только 127.0.0.1)
PROTON_BRIDGE_IMAP_PORT=1143
PROTON_BRIDGE_SMTP_PORT=1025
PROTON_BRIDGE_EMAIL=your_monada@proton.me
PROTON_BRIDGE_APP_PASSWORD=your_app_specific_password_here

# Монолит / Гептархия
MONADA_LLM_URL=http://127.0.0.1:8080/v1/chat/completions

# Подсознание NPU
PODSOZNANIE_URL=http://127.0.0.1:13305

# Пути
MONADA_ROOT=/home/angelan/data/Monada-Hardcore
DANCEFLOOR=/mnt/dancefloor
